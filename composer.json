{
    "name": "leafs/cli",
    "description": "A simple command line tool for installing and interacting with your leaf apps",
    "homepage": "https://cli.leafphp.dev",
    "version": "v5.0-dev",
    "keywords": [
        "leaf",
        "php",
        "installer",
        "deploy",
        "server",
        "database"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Darko",
            "email": "mickdd22@gmail.com",
            "homepage": "https://mychi.netlify.app",
            "role": "Developer"
        }
    ],
    "require": {
        "ext-json": "*",
        "leafs/fs": "^4.1",
        "leafs/sprout": "*",
        "psy/psysh": "*"
    },
    "bin": [
        "bin/leaf"
    ],
    "autoload": {
        "psr-4": {
            "Leaf\\Console\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.66",
        "leafs/alchemy": "v5.x-dev"
    },
    "scripts": {
        "alchemy": "./vendor/bin/alchemy setup",
        "test": "./vendor/bin/alchemy test",
        "lint": "./vendor/bin/alchemy lint",
        "fmt": "./vendor/bin/alchemy fmt",
        "ci": "./vendor/bin/alchemy ci"
    }
}
