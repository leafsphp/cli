#!/usr/bin/env php
<?php

if (file_exists(dirname(__DIR__, 3) . "/autoload.php")) {
    require dirname(__DIR__, 3) . "/autoload.php";
} else {
    require dirname(__DIR__) . "/vendor/autoload.php";
}

// composer.json carries no version key (packagist derives it from tags),
// so ask composer's runtime for the installed version instead
$currentVersion = \Composer\InstalledVersions::isInstalled('leafs/cli')
    ? \Composer\InstalledVersions::getPrettyVersion('leafs/cli')
    : 'dev';

$app = sprout()->createApp([
    'name' => "
 _              __    ___ _    ___ 
| |   ___ __ _ / _|  / __| |  |_ \033[1;33m$currentVersion\033[0m
| |__/ -_) _` |  _| | (__| |__ | | 
|____\___\__,_|_|    \___|____|___|
    ",
    'version' => $currentVersion
]);

$app->register(Leaf\Console\CreateCommand::class);
$app->register(Leaf\Console\UpdateCommand::class);
$app->register(Leaf\Console\InstallCommand::class);
$app->register(Leaf\Console\UninstallCommand::class);
$app->register(Leaf\Console\ServeCommand::class);
$app->register(Leaf\Console\InteractCommand::class);
$app->register(Leaf\Console\RunCommand::class);
$app->register(Leaf\Console\ViewBuildCommand::class);
$app->register(Leaf\Console\ViewInstallCommand::class);
$app->register(Leaf\Console\DeployCommand::class);
$app->register(Leaf\Console\ContextCommand::class);
$app->register(Leaf\Console\UpCommand::class);

$app->on('command.notFound', function ($event) use ($app) {
    $data = array_slice($event->getCommandArgv(), 1);

    if (\Leaf\FS\File::exists(getcwd() . '/leaf')) {
        $exitCode = (int) sprout()->run(
            'php leaf ' . implode(' ', $data),
            null
        );

        $event->setExitCode($exitCode);
        $event->stopPropagation();
    }
});

exit((int) ($app->run(false) ?? 0));
